# Raw and derived PulseDB/PPG-DaLiA data — not redistributable (PulseDB's
# VitalDB portion is CC BY-NC-SA) and too large (21 GB). Code to regenerate
# every one of these from the public sources is in src/ and scripts/.
data/raw/
data/processed/
data/features/
bp/data/

# Superseded run snapshots, kept locally for history but not needed to
# reproduce the manuscript's numbers (results/overview/RESULTS.md is
# generated from the current results/models/ files, not from archive/).
results/archive/

__pycache__/
*.py[cod]
.ipynb_checkpoints/
.DS_Store

# Local tooling, not part of the project
.claude/

# Manuscript drafts — not part of the code release; still under journal
# review, kept out of the public repo until that's resolved.
docs/
ieee_paper/

# bp/ is a Colab staging folder assembled on demand by
# scripts/make_drive_folder.py, which hard-links src/, notebooks/,
# HANDOFF.md, and scripts/prepare_colab_upload.py into it. Everything
# except README.txt here is therefore a generated duplicate of files
# already tracked at the repository root.
bp/src/
bp/notebooks/
bp/scripts/
bp/HANDOFF.md
